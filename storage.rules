rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function validImageUpload() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');
    }

    match /lead-documents/{leadId}/{fileName} {
      allow create: if validImageUpload();
      allow read, update, delete: if isAdmin();
    }

    match /site-assets/{fileName} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && validImageUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
